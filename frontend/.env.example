# ============================================================
# Frontend Environment Variables – EXAMPLE
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git!
# ============================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# NOTE: Do NOT put GEMINI_API_KEY here.
# The Gemini key must only live in the backend .env to avoid
# being exposed in the browser JavaScript bundle.

# Firebase Configuration (optional – for push notifications)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Supabase (only if the frontend directly queries Supabase)
VITE_SUPABASE_URL=https://your_project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key