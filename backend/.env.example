# ============================================================
# Backend Environment Variables – EXAMPLE
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git!
# ============================================================

# Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Supabase PostgreSQL
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# JWT (use a long random string ≥ 256 bits for production)
JWT_SECRET=YourSuperSecretKeyForHS256Algorithm_MustBeAtLeast256BitsLong
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Email (SMTP – use a Gmail App Password, NOT your account password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_PROTOCOL=smtp
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Google Cloud Vision (path to your service account key JSON file)
GOOGLE_APPLICATION_CREDENTIALS=./src/main/resources/gcp-key.json

# File Upload
FILE_UPLOAD_DIR=./uploads